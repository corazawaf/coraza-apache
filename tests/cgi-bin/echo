#!/bin/sh
# Echo endpoint for the request-body replay tests (issue #34).
#
# Writes the request body back verbatim so a test can assert on what the
# handler actually received, not just on a status code. It reads stdin to EOF
# on purpose rather than CONTENT_LENGTH bytes: if the replayed body is not
# terminated by an EOS bucket the read blocks, and the test then fails on
# curl's --max-time instead of passing on an empty body.
#
# All of stdin is drained into a temp file before any output is written.
# mod_cgi (prefork) sends the whole request body to the script before it
# reads the script's stdout, so echoing while reading deadlocks once the body
# outgrows the pipe buffers; slurping first makes the test valid on both CGI
# transports.
#
# A phase-3/4 drop (issue #76) closes the client connection while this script
# may still be writing; with SIGPIPE at its default the script dies of the
# signal, PID 1 (httpd) reaps the orphan and logs AH00052 "exit signal Broken
# pipe", which the crash sweep would mistake for a worker crash (the bulk
# fixture has the same guard). Ignore the signal and exit cleanly on EPIPE.
trap '' PIPE
body=$(mktemp)
cat > "$body"
/usr/bin/printf 'Content-Type: text/plain\r\n\r\n' || exit 0
/usr/bin/printf 'CONTENT_LENGTH=[%s]\n' "${CONTENT_LENGTH:-}" || exit 0
/usr/bin/printf 'BODY=[' || exit 0
cat "$body" || :
/usr/bin/printf ']\n' || :
rm -f "$body"
exit 0
